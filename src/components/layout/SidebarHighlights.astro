---
import { siteConfig } from '@constants/site-config';
import { buildCategoryPath, buildTagPath, translateCategoryName } from '@lib/content';
import { Icon } from 'astro-icon/components';
import { type Locale, localizedPath } from '@/i18n';

interface TagCount {
  tag: string;
  count: number;
}

interface Props {
  locale: Locale;
  tags: TagCount[];
  categoryCounts: Record<string, number>;
  postCount: number;
}

const { locale, tags, categoryCounts, postCount } = Astro.props;

const contentCategoryNames = [
  '生活记录',
  '前端笔记',
  '后端笔记',
  '技术分析',
  '交易人生',
  '面相与命理八字',
  '生活经验',
  '精神底色',
];
const contentCategories = contentCategoryNames.map((name) => ({ name, count: categoryCounts[name] ?? 0 }));

const copy =
  locale === 'en'
    ? {
        roadmapTitle: 'Growth path',
        roadmapDescription: 'Frontend · Backend · AI Agent',
        roadmapAction: 'View career plan',
        manifestoEyebrow: 'CONTENT INDEX',
        manifestoTitle: 'Content directory',
        manifestoCopy: 'Most new notes will fit into these eight paths.',
        categoryTitle: 'Content directories',
        tagTitle: 'Common tags',
      }
    : locale === 'ja'
      ? {
          roadmapTitle: '成長ルート',
          roadmapDescription: 'Frontend · Backend · AI Agent',
          roadmapAction: 'キャリアプランを見る',
          manifestoEyebrow: 'CONTENT INDEX',
          manifestoTitle: 'コンテンツ分類',
          manifestoCopy: 'これからの記録は、この8つの方向に分けて整理します。',
          categoryTitle: 'コンテンツ分類',
          tagTitle: 'よく読むタグ',
        }
      : {
          roadmapTitle: '成长路线',
          roadmapDescription: '前端 · 后端 · AI Agent',
          roadmapAction: '查看职业规划',
          manifestoEyebrow: '内容索引',
          manifestoTitle: '内容目录',
          manifestoCopy: '后续内容主要围绕这 8 个方向更新。',
          categoryTitle: '八个方向',
          tagTitle: '常用标签',
        };
---

<div class="mt-5 flex w-full flex-col gap-4 px-1">
  <a
    href={localizedPath('/about', locale)}
    class="growth-route group relative block min-h-28 w-full rounded-lg text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#5368e8] focus-visible:ring-offset-2"
  >
    <span class="growth-route-inner block min-h-28 w-full">
      <span
        class="growth-route-face absolute inset-0 block overflow-hidden rounded-lg border border-[#465bd8] bg-[#5368e8] px-4 py-4 text-left shadow-sm"
      >
        <Icon name="ri:route-line" class="absolute right-2 top-1/2 size-20 -translate-y-1/2 text-white/15" aria-hidden="true" />
        <span class="relative mt-1 block text-2xl font-black">{copy.roadmapTitle}</span>
        <span class="relative mt-2 block max-w-48 text-sm/5 font-medium text-white/90">{copy.roadmapDescription}</span>
      </span>
      <span
        class="growth-route-back growth-route-face absolute inset-0 flex items-center justify-center gap-2 rounded-lg border border-[#465bd8] bg-[#5368e8] px-4 py-4 text-lg font-black shadow-md"
      >
        <Icon name="ri:arrow-right-line" class="size-7" aria-hidden="true" />
        <span>{copy.roadmapAction}</span>
      </span>
    </span>
  </a>

  <site-analytics
    class="site-analytics relative block w-full overflow-hidden rounded-lg border border-[#e7eaf0] bg-white/70 px-4 py-4 text-left shadow-sm dark:border-white/10 dark:bg-white/5"
    data-established-at={siteConfig.establishedAt ?? `${siteConfig.startYear ?? new Date().getFullYear()}-01-01`}
    data-site-url={siteConfig.site}
    data-visit-offset={siteConfig.siteVisitOffset ?? 0}
    data-visitor-offset={siteConfig.siteVisitorOffset ?? 0}
    data-production={import.meta.env.PROD ? 'true' : 'false'}
  >
    <div class="relative z-10 border-b border-dashed border-[#dfe3ea] pb-3 dark:border-white/10">
      <p class="text-[0.65rem] font-bold text-[#6375e6] dark:text-[#aeb8ff]">
        {locale === 'en' ? 'SITE NOTES' : locale === 'ja' ? 'サイト記録' : '站点记录'}
      </p>
      <h2 class="mt-1 text-base/5 font-bold text-[#3d4759] dark:text-[#f3f4f6]">
        {locale === 'en' ? 'A record in progress' : locale === 'ja' ? '積み重ねの記録' : '持续积累中'}
      </h2>
    </div>
    <dl class="relative z-10 mt-3 space-y-2 text-sm">
      <div class="flex items-center justify-between gap-4">
        <dt class="text-[#7f899a] dark:text-[#a5acb8]">{locale === 'en' ? 'Posts' : locale === 'ja' ? '記事数' : '文章数'}</dt>
        <dd class="font-semibold text-[#3d4759] dark:text-[#f3f4f6]">{postCount}</dd>
      </div>
      <div class="flex items-center justify-between gap-4">
        <dt class="text-[#7f899a] dark:text-[#a5acb8]">{locale === 'en' ? 'Days online' : locale === 'ja' ? '運営日数' : '建站天数'}</dt>
        <dd class="font-semibold text-[#3d4759] dark:text-[#f3f4f6]"><span data-site-days>--</span>{locale === 'en' ? ' days' : locale === 'ja' ? ' 日' : ' 天'}</dd>
      </div>
      <div class="flex items-center justify-between gap-4">
        <dt class="text-[#7f899a] dark:text-[#a5acb8]">{locale === 'en' ? 'Page views' : locale === 'ja' ? '全体アクセス' : '全站访问量'}</dt>
        <dd class="font-semibold text-[#3d4759] dark:text-[#f3f4f6]" data-site-pageviews>--</dd>
      </div>
      <div class="flex items-center justify-between gap-4">
        <dt class="text-[#7f899a] dark:text-[#a5acb8]">{locale === 'en' ? 'Visitors' : locale === 'ja' ? '訪問者数' : '访客数'}</dt>
        <dd class="font-semibold text-[#3d4759] dark:text-[#f3f4f6]" data-site-visitors>--</dd>
      </div>
    </dl>
    <img src="/img/allen-mascot.webp" alt="" aria-hidden="true" class="pointer-events-none absolute -right-5 -bottom-8 w-28 opacity-20 dark:opacity-15" />
  </site-analytics>

  <section class="border-border/70 bg-card/60 w-full rounded-lg border px-4 py-4 text-left shadow-sm">
    <div class="border-l-2 border-[#5368e8] pl-3 dark:border-[#9bacff]">
      <p class="text-[0.65rem] font-bold tracking-[0.08em] text-[#5368e8] dark:text-[#9bacff]">{copy.manifestoEyebrow}</p>
      <h2 class="text-primary mt-1 text-base/5 font-bold">{copy.manifestoTitle}</h2>
    </div>
    <p class="text-muted-foreground mt-3 text-sm/6">{copy.manifestoCopy}</p>

    <div class="border-border/70 mt-4 border-t border-dashed pt-3">
      <p class="text-muted-foreground mb-2 text-xs font-medium">{copy.categoryTitle}</p>
      <nav class="flex flex-col gap-0.5" aria-label={copy.categoryTitle}>
        {contentCategories.map(({ name, count }) => (
          <a
            href={localizedPath(buildCategoryPath(name), locale)}
            class="text-muted-foreground hover:text-blue group flex min-w-0 items-center justify-between gap-2 rounded-md px-2 py-1.5 text-sm transition-colors focus-visible:outline-none"
          >
            <span class="truncate">{translateCategoryName(name, locale)}</span>
            <span class="shrink-0 text-xs text-[#5368e8]/70 dark:text-[#aeb8ff]/80">{count}</span>
          </a>
        ))}
      </nav>
    </div>

    {tags.length > 0 && (
      <div class="border-border/70 mt-3 border-t border-dashed pt-3">
        <p class="text-muted-foreground mb-2 text-xs font-medium">{copy.tagTitle}</p>
        <nav class="flex flex-wrap gap-1.5" aria-label={copy.tagTitle}>
          {tags.map(({ tag, count }) => (
            <a
              href={localizedPath(buildTagPath(tag), locale)}
              class="text-muted-foreground hover:text-blue focus-visible:text-blue inline-flex items-baseline rounded-md bg-black/[0.035] px-2 py-1 text-sm transition-colors focus-visible:outline-none dark:bg-white/[0.06]"
            >
              {tag}<sup class="ml-1 text-[0.65rem] text-[#5368e8]/70 dark:text-[#aeb8ff]/80">{count}</sup>
            </a>
          ))}
        </nav>
      </div>
    )}
  </section>
</div>

<script>
  type BusuanziStats = {
    site_pv?: number | string;
    site_uv?: number | string;
  };

  type AnalyticsWindow = Window & {
    __siteAnalyticsReady?: boolean;
  };

  function formatCount(value: unknown, offset: number): string {
    const count = Number(value);
    return Number.isFinite(count) ? (count + offset).toLocaleString() : '--';
  }

  function setSiteCounters(container: HTMLElement, stats?: BusuanziStats) {
    const pageviews = container.querySelector<HTMLElement>('[data-site-pageviews]');
    const visitors = container.querySelector<HTMLElement>('[data-site-visitors]');
    const visitOffset = Number(container.dataset.visitOffset ?? 0);
    const visitorOffset = Number(container.dataset.visitorOffset ?? 0);

    if (pageviews) pageviews.textContent = stats ? formatCount(stats.site_pv, visitOffset) : '--';
    if (visitors) visitors.textContent = stats ? formatCount(stats.site_uv, visitorOffset) : '--';
  }

  function setSiteDays(container: HTMLElement) {
    const element = container.querySelector<HTMLElement>('[data-site-days]');
    const establishedAt = container.dataset.establishedAt;
    if (!element || !establishedAt) return;

    const start = new Date(`${establishedAt}T00:00:00`);
    if (Number.isNaN(start.getTime())) return;

    const days = Math.max(1, Math.ceil((Date.now() - start.getTime()) / 86_400_000));
    element.textContent = days.toLocaleString();
  }

  function loadBusuanzi(container: HTMLElement) {
    const siteUrl = container.dataset.siteUrl;
    const isProduction = container.dataset.production === 'true';
    if (!siteUrl || !isProduction) {
      setSiteCounters(container);
      return;
    }

    let host: string;
    try {
      host = new URL(siteUrl).hostname;
    } catch {
      setSiteCounters(container);
      return;
    }

    if (window.location.hostname !== host) {
      setSiteCounters(container);
      return;
    }

    const callbackName = `siteAnalytics${Date.now()}${Math.random().toString(36).slice(2)}`;
    const callbackWindow = window as unknown as Record<string, unknown>;
    const script = document.createElement('script');
    const timeout = window.setTimeout(() => {
      setSiteCounters(container);
      script.remove();
      delete callbackWindow[callbackName];
    }, 4_000);

    callbackWindow[callbackName] = (stats: BusuanziStats) => {
      window.clearTimeout(timeout);
      setSiteCounters(container, stats);
      script.remove();
      delete callbackWindow[callbackName];
    };

    script.async = true;
    script.src = `https://busuanzi.ibruce.info/busuanzi?jsonpCallback=${callbackName}`;
    script.onerror = () => {
      window.clearTimeout(timeout);
      setSiteCounters(container);
      delete callbackWindow[callbackName];
    };
    document.head.appendChild(script);
  }

  function initSiteAnalytics() {
    document.querySelectorAll<HTMLElement>('site-analytics:not([data-site-analytics-ready])').forEach((container) => {
      container.dataset.siteAnalyticsReady = 'true';
      setSiteDays(container);
      loadBusuanzi(container);
    });
  }

  const analyticsWindow = window as AnalyticsWindow;
  initSiteAnalytics();
  if (!analyticsWindow.__siteAnalyticsReady) {
    analyticsWindow.__siteAnalyticsReady = true;
    document.addEventListener('astro:page-load', initSiteAnalytics);
  }
</script>

<style>
  .growth-route {
    perspective: 1000px;
  }

  .growth-route-inner {
    position: relative;
    transform-style: preserve-3d;
    transition: transform 500ms ease;
  }

  .growth-route-face {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .growth-route-back {
    transform: rotateY(-180deg);
  }

  .growth-route:hover .growth-route-inner,
  .growth-route:focus-visible .growth-route-inner {
    transform: rotateY(-180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .growth-route-inner {
      transition: none;
    }
  }
</style>
