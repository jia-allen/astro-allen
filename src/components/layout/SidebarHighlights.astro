---
import { buildTagPath } from '@lib/content';
import { Icon } from 'astro-icon/components';
import { localizedPath } from '@/i18n';

interface TagCount {
  tag: string;
  count: number;
}

interface Props {
  locale: string;
  tags: TagCount[];
}

const { locale, tags } = Astro.props;

const copy =
  locale === 'en'
    ? {
        roadmapEyebrow: "ALLEN'S ROADMAP",
        roadmapTitle: 'Growth path',
        roadmapDescription: 'Frontend · Backend · AI Agent',
        roadmapAction: 'View career plan',
        manifestoEyebrow: "ALLEN'S NOTE",
        manifestoTitle: 'Why I write',
        manifestoCopy: 'Public writing turns learning into lasting credit. What gets written down becomes part of the path.',
        tagTitle: 'Current threads',
      }
    : locale === 'ja'
      ? {
          roadmapEyebrow: "ALLEN'S ROADMAP",
          roadmapTitle: '成長ルート',
          roadmapDescription: 'Frontend · Backend · AI Agent',
          roadmapAction: 'キャリアプランを見る',
          manifestoEyebrow: "ALLEN'S NOTE",
          manifestoTitle: 'なぜ書くのか',
          manifestoCopy: '公開して書き続けることで、学びは長期的な信用になる。書き残したものが、自分の歩みになる。',
          tagTitle: 'いま考えていること',
        }
      : {
          roadmapEyebrow: "ALLEN'S ROADMAP",
          roadmapTitle: '成长路线',
          roadmapDescription: '前端 · 后端 · AI Agent',
          roadmapAction: '查看职业规划',
          manifestoEyebrow: "ALLEN'S NOTE",
          manifestoTitle: '为什么写博客',
          manifestoCopy: '持续公开输出，让学习沉淀为长期信用。写下来的，才会真正成为自己走过的路。',
          tagTitle: '正在沉淀',
        };
---

<div class="mt-5 flex w-full flex-col gap-4 px-1">
  <a
    href={localizedPath('/about', locale)}
    class="growth-route group relative block min-h-28 w-full rounded-lg text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#5368e8] focus-visible:ring-offset-2"
  >
    <span class="growth-route-inner block min-h-28 w-full">
      <span
        class="growth-route-face absolute inset-0 block overflow-hidden rounded-lg border border-[#465bd8] bg-[#5368e8] px-4 py-4 text-left shadow-sm"
      >
        <Icon name="ri:route-line" class="absolute right-2 top-1/2 size-20 -translate-y-1/2 text-white/15" aria-hidden="true" />
        <span class="relative block text-[0.65rem] font-bold text-white/70">{copy.roadmapEyebrow}</span>
        <span class="relative mt-1 block text-2xl font-black">{copy.roadmapTitle}</span>
        <span class="relative mt-2 block max-w-48 text-sm/5 font-medium text-white/90">{copy.roadmapDescription}</span>
      </span>
      <span
        class="growth-route-back growth-route-face absolute inset-0 flex items-center justify-center gap-2 rounded-lg border border-[#465bd8] bg-[#5368e8] px-4 py-4 text-lg font-black shadow-md"
      >
        <Icon name="ri:arrow-right-line" class="size-7" aria-hidden="true" />
        <span>{copy.roadmapAction}</span>
      </span>
    </span>
  </a>

  <section class="border-border/70 bg-card/60 w-full rounded-lg border px-4 py-4 text-left shadow-sm">
    <div class="flex items-center gap-3">
      <span class="grid size-9 shrink-0 place-items-center rounded-full bg-[#5368e8] font-serif text-base font-bold text-white">A</span>
      <div class="min-w-0">
        <p class="text-[0.65rem] font-bold text-[#5368e8] dark:text-[#9bacff]">{copy.manifestoEyebrow}</p>
        <h2 class="text-primary mt-1 text-base/5 font-bold">{copy.manifestoTitle}</h2>
      </div>
    </div>
    <p class="text-muted-foreground mt-3 text-sm/6">{copy.manifestoCopy}</p>

    {tags.length > 0 && (
      <div class="border-border/70 mt-4 border-t border-dashed pt-3">
        <p class="text-muted-foreground mb-2 text-xs font-medium">{copy.tagTitle}</p>
        <nav class="flex flex-wrap gap-x-3 gap-y-2" aria-label={copy.tagTitle}>
          {tags.map(({ tag, count }) => (
            <a
              href={localizedPath(buildTagPath(tag), locale)}
              class="text-primary hover:text-blue focus-visible:text-blue text-sm transition-colors focus-visible:outline-none"
            >
              {tag}<sup class="text-muted-foreground ml-0.5 text-[0.65rem]">{count}</sup>
            </a>
          ))}
        </nav>
      </div>
    )}
  </section>
</div>

<style>
  .growth-route {
    perspective: 1000px;
  }

  .growth-route-inner {
    position: relative;
    transform-style: preserve-3d;
    transition: transform 500ms ease;
  }

  .growth-route-face {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .growth-route-back {
    transform: rotateY(-180deg);
  }

  .growth-route:hover .growth-route-inner,
  .growth-route:focus-visible .growth-route-inner {
    transform: rotateY(-180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .growth-route-inner {
      transition: none;
    }
  }
</style>
